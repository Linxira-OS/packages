# Maintainer: Linxira OS <admin@linxira.org>
# Release-asset repackage: assets 模式由 upstream-sync 追踪(SHA256SUMS.txt 回填)。
# 分发走 [linxira-zeta] 仓库(packages 仓库 Release 资产), 不进 linxira-packages git(100MB 限制)。

pkgname=linxira-zeta-ide
pkgver=1.1.26
pkgrel=1
pkgdesc='Zeta terminal IDE (TermIDE, release binary)'
arch=('x86_64')
url='https://github.com/Linxira-OS/linxira-zeta'
license=('MIT')
options=('!strip' '!debug')
provides=('zetaide')
source=("zeta-ide-linux-x64::https://github.com/Linxira-OS/linxira-zeta/releases/download/v${pkgver}/zeta-ide-linux-x64")
# assets 模式: sha256 由 sync-upstream.py 自动回填; 资产未上传前为 SKIP(构建跳过)
sha256sums=('SKIP')

check() {
  chmod +x "$srcdir/zeta-ide-linux-x64"
  head -c 4 "$srcdir/zeta-ide-linux-x64" | grep -q $'\x7fELF'
}

package() {
  install -Dm755 "$srcdir/zeta-ide-linux-x64" "$pkgdir/usr/bin/zetaide"
}
