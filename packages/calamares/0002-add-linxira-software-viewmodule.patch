+/* SPDX-License-Identifier: GPL-3.0-or-later */
+
+#include "LinxiraSoftwareViewStep.h"
+
+#include "GlobalStorage.h"
+#include "JobQueue.h"
+#include "utils/PluginFactory.h"
+
+#include <QCryptographicHash>
+#include <QFile>
+#include <QHeaderView>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QLabel>
+#include <QLocale>
+#include <QSet>
+#include <QTabWidget>
+#include <QTreeWidget>
+#include <QTcpSocket>
+#include <QVBoxLayout>
+
+namespace
+{
+constexpr int IdRole = Qt::UserRole;
+constexpr int KindRole = Qt::UserRole + 1;
+constexpr int CategoryRole = Qt::UserRole + 2;
+constexpr int OfflinePolicyRole = Qt::UserRole + 3;
+constexpr int CategorySelectionRole = Qt::UserRole + 4;
+constexpr int CategoryMaximumRole = Qt::UserRole + 5;
+constexpr int SelectableRole = Qt::UserRole + 6;
+
+QString localized( const QJsonValue& value )
+{
+    if ( value.isString() )
+    {
+        return value.toString();
+    }
+    const auto object = value.toObject();
+    const auto locale = QLocale().name();
+    if ( object.contains( locale ) )
+    {
+        return object.value( locale ).toString();
+    }
+    const auto language = locale.section( QLatin1Char( '_' ), 0, 0 );
+    if ( object.contains( language ) )
+    {
+        return object.value( language ).toString();
+    }
+    return object.value( QStringLiteral( "en" ) ).toString();
+}
+
+QStringList stringList( const QJsonArray& array )
+{
+    QStringList values;
+    for ( const auto& value : array )
+    {
+        if ( value.isString() )
+        {
+            values.append( value.toString() );
+        }
+    }
+    return values;
+}
+}  // namespace
+
+CALAMARES_PLUGIN_FACTORY_DEFINITION( LinxiraSoftwareViewStepFactory,
+                                     registerPlugin< LinxiraSoftwareViewStep >(); )
+
+LinxiraSoftwareViewStep::LinxiraSoftwareViewStep( QObject* parent )
+    : Calamares::ViewStep( parent )
+{
+}
+
+LinxiraSoftwareViewStep::~LinxiraSoftwareViewStep()
+{
+    if ( m_widget && !m_widget->parent() )
+    {
+        m_widget->deleteLater();
+    }
+}
+
+QString LinxiraSoftwareViewStep::prettyName() const
+{
+    return tr( "Software" );
+}
+
+QString LinxiraSoftwareViewStep::prettyStatus() const
+{
+    return tr( "%1 software items selected" ).arg( selectedLeafIds().size() );
+}
+
+QWidget* LinxiraSoftwareViewStep::widget()
+{
+    if ( m_widget )
+    {
+        return m_widget;
+    }
+
+    m_widget = new QWidget;
+    auto* layout = new QVBoxLayout( m_widget );
+    auto* title = new QLabel( tr( "Choose software and system capabilities" ) );
+    QFont titleFont = title->font();
+    titleFont.setPointSize( titleFont.pointSize() + 4 );
+    titleFont.setBold( true );
+    title->setFont( titleFont );
+    layout->addWidget( title );
+
+    auto* description = new QLabel(
+        tr( "Included items are installed from the ISO. Other reviewed choices are recorded for completion after first boot." ) );
+    description->setWordWrap( true );
+    layout->addWidget( description );
+
+    // 2026-08-13: 恢复 gpuNote(驱动说明, 原 611 行 patch 特性)
+    auto* gpuNote = new QLabel(
+        tr( "安装过程使用核显/开源驱动输出；独立显卡驱动（NVIDIA/AMD）将在装完系统后由 Linxira 驱动管理器自动安装。" ) );
+    gpuNote->setWordWrap( true );
+    layout->addWidget( gpuNote );
+
+    auto* tabs = new QTabWidget;
+    m_applications = makeTree();
+    m_components = makeTree();
+    m_desktops = makeTree();
+    tabs->addTab( m_desktops, tr( "Desktop" ) );
+    tabs->addTab( m_applications, tr( "Applications" ) );
+    tabs->addTab( m_components, tr( "Components" ) );
+    layout->addWidget( tabs, 1 );
+
+    // 2026-08-14: 多目标网络探测(清华镜像/Arch 官方/阿里云, 任一可达即在线);
+    // 国内网络 mirror.archlinux.org 常超时导致误判离线, 先探测国内外均可达的 tuna。
+    {
+        const QStringList probeHosts = {
+            QStringLiteral( "mirrors.tuna.tsinghua.edu.cn" ),
+            QStringLiteral( "mirror.archlinux.org" ),
+            QStringLiteral( "mirrors.aliyun.com" ),
+        };
+        for ( const QString& host : probeHosts )
+        {
+            QTcpSocket probe;
+            probe.connectToHost( host, 443 );
+            if ( probe.waitForConnected( 3000 ) )
+            {
+                m_online = true;
+                break;
+            }
+        }
+    }
+    if ( !m_online )
+    {
+        description->setText( tr( "💿 Offline mode — only pre-installed software is available" ) );
+    }
+
+    m_status = new QLabel;
+    m_status->setWordWrap( true );
+    layout->addWidget( m_status );
+
+    QString error;
+    m_ready = loadCatalog( &error );
+    if ( !m_ready )
+    {
+        m_status->setText( tr( "Catalog could not be loaded: %1" ).arg( error ) );
+    }
+    else
+    {
+        updateStatus();
+    }
+    emit nextStatusChanged( m_ready );
+    return m_widget;
+}
+
+bool LinxiraSoftwareViewStep::isNextEnabled() const
+{
+    return m_ready && selectionValid();
+}
+
+bool LinxiraSoftwareViewStep::isBackEnabled() const
+{
+    return true;
+}
+
+bool LinxiraSoftwareViewStep::isAtBeginning() const
+{
+    return true;
+}
+
+bool LinxiraSoftwareViewStep::isAtEnd() const
+{
+    return true;
+}
+
+void LinxiraSoftwareViewStep::onActivate()
+{
+    if ( !m_widget )
+    {
+        widget();
+    }
+    restoreSelection();
+}
+
+void LinxiraSoftwareViewStep::onLeave()
+{
+    auto* storage = Calamares::JobQueue::instanceGlobalStorage();
+    if ( !storage || !m_ready )
+    {
+        return;
+    }
+
+    QVariantMap selection;
+    selection.insert( QStringLiteral( "schemaVersion" ),
+                      QStringLiteral( "org.linxira.installer-selection.v1" ) );
+    selection.insert( QStringLiteral( "catalogVersion" ), 3 );
+    selection.insert( QStringLiteral( "catalogRelease" ), m_release );
+    selection.insert( QStringLiteral( "catalogSha256" ), m_catalogSha256 );
+    selection.insert( QStringLiteral( "selectedLeafIds" ), selectedLeafIds() );
+    selection.insert( QStringLiteral( "selectedBundleIds" ), selectedBundleIds() );
+    storage->insert( m_storageKey, selection );
+}
+
+Calamares::JobList LinxiraSoftwareViewStep::jobs() const
+{
+    return {};
+}
+
+void LinxiraSoftwareViewStep::setConfigurationMap( const QVariantMap& configurationMap )
+{
+    m_catalogPath = configurationMap.value(
+        QStringLiteral( "catalogPath" ),
+        QStringLiteral( "/usr/share/linxira/catalog/catalog-v3.json" ) ).toString();
+    m_storageKey = configurationMap.value(
+        QStringLiteral( "globalStorageKey" ),
+        QStringLiteral( "linxiraSoftwareSelection" ) ).toString();
+}
+
+QTreeWidget* LinxiraSoftwareViewStep::makeTree()
+{
+    auto* tree = new QTreeWidget;
+    tree->setColumnCount( 3 );
+    tree->setHeaderLabels( { tr( "Feature" ), tr( "Role" ), tr( "Install timing" ) } );
+    tree->header()->setSectionResizeMode( 0, QHeaderView::Stretch );
+    tree->header()->setSectionResizeMode( 1, QHeaderView::ResizeToContents );
+    tree->header()->setSectionResizeMode( 2, QHeaderView::ResizeToContents );
+    tree->setUniformRowHeights( true );
+    connect( tree, &QTreeWidget::itemChanged, this, &LinxiraSoftwareViewStep::itemChanged );
+    return tree;
+}
+
+bool LinxiraSoftwareViewStep::loadCatalog( QString* error )
+{
+    QFile file( m_catalogPath );
+    if ( !file.open( QIODevice::ReadOnly ) )
+    {
+        *error = file.errorString();
+        return false;
+    }
+    const QByteArray raw = file.readAll();
+    QJsonParseError parseError;
+    const auto document = QJsonDocument::fromJson( raw, &parseError );
+    if ( parseError.error != QJsonParseError::NoError || !document.isObject() )
+    {
+        *error = parseError.errorString();
+        return false;
+    }
+    const auto root = document.object();
+    if ( root.value( QStringLiteral( "catalogVersion" ) ).toInt() != 3 )
+    {
+        *error = tr( "unsupported catalog version" );
+        return false;
+    }
+
+    m_release = root.value( QStringLiteral( "release" ) ).toString();
+    m_catalogSha256 = QString::fromLatin1(
+        QCryptographicHash::hash( raw, QCryptographicHash::Sha256 ).toHex() );
+
+    for ( const auto& section : { QStringLiteral( "desktops" ),
+                                  QStringLiteral( "applications" ),
+                                  QStringLiteral( "components" ),
+                                  QStringLiteral( "bundles" ),
+                                  QStringLiteral( "operations" ) } )
+    {
+        for ( const auto& value : root.value( section ).toArray() )
+        {
+            const auto object = value.toObject();
+            const auto id = object.value( QStringLiteral( "id" ) ).toString();
+            if ( id.isEmpty() || m_nodes.contains( id ) )
+            {
+                *error = tr( "duplicate or empty catalog ID" );
+                return false;
+            }
+            m_nodes.insert( id, object );
+        }
+    }
+
+    m_updating = true;
+    for ( const auto& value : root.value( QStringLiteral( "categories" ) ).toArray() )
+    {
+        const auto category = value.toObject();
+        const auto surface = category.value( QStringLiteral( "surface" ) ).toString();
+        QTreeWidget* tree = surface == QStringLiteral( "desktops" ) ? m_desktops
+                           : surface == QStringLiteral( "applications" ) ? m_applications
+                           : surface == QStringLiteral( "components" ) ? m_components
+                                                                      : nullptr;
+        if ( !tree )
+        {
+            continue;
+        }
+        auto* item = new QTreeWidgetItem( tree );
+        item->setText( 0, localized( category.value( QStringLiteral( "name" ) ) ) );
+        item->setData( 0, IdRole, category.value( QStringLiteral( "id" ) ).toString() );
+        item->setData( 0, KindRole, QStringLiteral( "category" ) );
+        const auto categorySelection = category.value( QStringLiteral( "selection" ) ).toObject();
+        item->setData( 0, CategorySelectionRole,
+                       categorySelection.value( QStringLiteral( "mode" ) ).toString() );
+        item->setData( 0, CategoryMaximumRole,
+                       categorySelection.value( QStringLiteral( "maxSelected" ) ).toInt() );
+        item->setFlags( item->flags() | Qt::ItemIsUserCheckable | Qt::ItemIsAutoTristate );
+        item->setCheckState( 0, Qt::Unchecked );
+        const auto categoryId = category.value( QStringLiteral( "id" ) ).toString();
+        QSet< QString > visiting;
+        for ( const auto& child : category.value( QStringLiteral( "children" ) ).toArray() )
+        {
+            if ( !addNode( item, child.toString(), categoryId, QStringLiteral( "optional" ), visiting ) )
+            {
+                *error = tr( "invalid or cyclic catalog reference: %1" ).arg( child.toString() );
+                m_updating = false;
+                return false;
+            }
+        }
+        item->setExpanded( tree == m_desktops );
+    }
+    normalizeExclusiveCategories();
+    m_updating = false;
+    return true;
+}
+
+bool LinxiraSoftwareViewStep::addNode( QTreeWidgetItem* parent,
+                                       const QString& id,
+                                       const QString& categoryId,
+                                       const QString& role,
+                                       QSet< QString >& visiting )
+{
+    if ( !m_nodes.contains( id ) || visiting.contains( id ) )
+    {
+        return false;
+    }
+    const auto node = m_nodes.value( id );
+    const auto kind = node.value( QStringLiteral( "kind" ) ).toString();
+    auto* item = new QTreeWidgetItem( parent );
+    item->setText( 0, localized( node.value( QStringLiteral( "name" ) ) ) );
+    item->setText( 1, role );
+    item->setData( 0, IdRole, id );
+    item->setData( 0, KindRole, kind );
+    item->setData( 0, CategoryRole, categoryId );
+
+    if ( kind == QStringLiteral( "bundle" ) )
+    {
+        item->setFlags( item->flags() | Qt::ItemIsUserCheckable | Qt::ItemIsAutoTristate );
+        item->setCheckState( 0, Qt::Unchecked );
+        visiting.insert( id );
+        const auto children = node.value( QStringLiteral( "children" ) ).toObject();
+        for ( const auto& childRole : { QStringLiteral( "required" ),
+                                        QStringLiteral( "recommended" ),
+                                        QStringLiteral( "optional" ) } )
+        {
+            for ( const auto& child : children.value( childRole ).toArray() )
+            {
+                if ( !addNode( item, child.toString(), categoryId, childRole, visiting ) )
+                {
+                    return false;
+                }
+            }
+        }
+        visiting.remove( id );
+        return true;
+    }
+
+    const auto availability = node.value( QStringLiteral( "availability" ) ).toObject();
+    const auto review = node.value( QStringLiteral( "review" ) ).toObject();
+    const auto artifact = node.value( QStringLiteral( "artifact" ) ).toObject();
+    const auto offlinePolicy = availability.value( QStringLiteral( "offlinePolicy" ) ).toString();
+    const bool reviewed = review.value( QStringLiteral( "status" ) ).toString() == QStringLiteral( "reviewed" );
+    const bool available = availability.value( QStringLiteral( "status" ) ).toString() == QStringLiteral( "available" );
+    const bool defaultChannel = availability.value( QStringLiteral( "channel" ) ).toString() == QStringLiteral( "default" );
+    const bool architecture = stringList( availability.value( QStringLiteral( "architectures" ) ).toArray() )
+                                  .contains( QStringLiteral( "x86_64" ) );
+    const bool supportedArtifact = artifact.value( QStringLiteral( "type" ) ).toString() == QStringLiteral( "package" )
+        || artifact.value( QStringLiteral( "type" ) ).toString() == QStringLiteral( "package-group" );
+    // 2026-08-13 修复: 去除 pacmanArch/requiresAcceptance 误锁(AUR/Flatpak/steam 恢复可选,
+    // 由 reviewed+available 把关); 加回离线灰化(included || m_online)。
+    const bool included = offlinePolicy == QStringLiteral( "included" );
+    const bool selectable = kind != QStringLiteral( "operation" ) && reviewed && available
+        && defaultChannel && architecture && supportedArtifact
+        && ( included || m_online );
+    const auto provider = node.value( QStringLiteral( "provider" ) ).toString();
+
+    item->setData( 0, OfflinePolicyRole, offlinePolicy );
+    item->setData( 0, SelectableRole, selectable );
+    // 2026-08-13: 恢复 emoji 视觉标记(💿=ISO 预装 / 🌐=联网安装), 前缀于 Install timing 文本
+    // 2026-08-14: 离线灰化的在线项显示"需联网"而非 Review pending(误导)
+    item->setText( 2, included ? QStringLiteral( "💿 " ) + tr( "Included" )
+                               : selectable && offlinePolicy == QStringLiteral( "online-only" )
+                                   ? QStringLiteral( "🌐 " ) + tr( "Downloaded during installation (%1)" ).arg( provider )
+                                   : selectable ? QStringLiteral( "🌐 " ) + tr( "Downloaded during installation with consent (%1)" ).arg( provider )
+                                                : offlinePolicy == QStringLiteral( "online-only" ) && reviewed && available
+                                                    ? QStringLiteral( "🌐 " ) + tr( "Needs network (offline)" )
+                                                    : tr( "Review pending (%1)" ).arg( provider.isEmpty() ? kind : provider ) );
+    Qt::ItemFlags flags = item->flags();
+    if ( selectable )
+    {
+        flags |= Qt::ItemIsUserCheckable;
+    }
+    else
+    {
+        flags &= ~( Qt::ItemIsEnabled | Qt::ItemIsUserCheckable );
+    }
+    item->setFlags( flags );
+    item->setCheckState( 0, Qt::Unchecked );
+    if ( selectable && node.value( QStringLiteral( "presentation" ) ).toObject().value(
+             QStringLiteral( "defaultSelected" ) ).toBool() )
+    {
+        item->setCheckState( 0, Qt::Checked );
+    }
+    m_leafItems[ id ].append( item );
+    return true;
+}
+
+void LinxiraSoftwareViewStep::itemChanged( QTreeWidgetItem* item, int column )
+{
+    if ( m_updating || column != 0 )
+    {
+        return;
+    }
+    m_updating = true;
+    const auto kind = item->data( 0, KindRole ).toString();
+    QTreeWidgetItem* category = kind == QStringLiteral( "category" ) ? item : nullptr;
+    QTreeWidgetItem* choice = item;
+    while ( !category && choice->parent() )
+    {
+        if ( choice->parent()->data( 0, KindRole ).toString() == QStringLiteral( "category" ) )
+        {
+            category = choice->parent();
+            break;
+        }
+        choice = choice->parent();
+    }
+    if ( category
+         && category->data( 0, CategorySelectionRole ).toString() == QStringLiteral( "exclusive" )
+         && item->checkState( 0 ) != Qt::Unchecked )
+    {
+        QTreeWidgetItem* selectedChoice = category == item ? nullptr : choice;
+        for ( int child = 0; child < category->childCount(); ++child )
+        {
+            auto* sibling = category->child( child );
+            if ( !selectedChoice && sibling->checkState( 0 ) != Qt::Unchecked )
+            {
+                selectedChoice = sibling;
+            }
+            else if ( sibling != selectedChoice )
+            {
+                sibling->setCheckState( 0, Qt::Unchecked );
+            }
+        }
+    }
+    if ( kind != QStringLiteral( "category" ) && kind != QStringLiteral( "bundle" ) )
+    {
+        const auto id = item->data( 0, IdRole ).toString();
+        for ( auto* duplicate : m_leafItems.value( id ) )
+        {
+            if ( duplicate != item && duplicate->data( 0, SelectableRole ).toBool() )
+            {
+                duplicate->setCheckState( 0, item->checkState( 0 ) );
+            }
+        }
+    }
+    m_updating = false;
+    updateStatus();
+}
+
+QStringList LinxiraSoftwareViewStep::selectedLeafIds() const
+{
+    QStringList selected;
+    for ( auto it = m_leafItems.cbegin(); it != m_leafItems.cend(); ++it )
+    {
+        for ( const auto* item : it.value() )
+        {
+            if ( item->data( 0, SelectableRole ).toBool()
+                 && item->checkState( 0 ) == Qt::Checked )
+            {
+                selected.append( it.key() );
+                break;
+            }
+        }
+    }
+    selected.removeDuplicates();
+    selected.sort();
+    return selected;
+}
+
+bool LinxiraSoftwareViewStep::hasSelectedLeafDescendant( const QTreeWidgetItem* item ) const
+{
+    const auto kind = item->data( 0, KindRole ).toString();
+    if ( kind != QStringLiteral( "category" ) && kind != QStringLiteral( "bundle" ) )
+    {
+        return item->data( 0, SelectableRole ).toBool()
+            && item->checkState( 0 ) == Qt::Checked;
+    }
+    for ( int child = 0; child < item->childCount(); ++child )
+    {
+        if ( hasSelectedLeafDescendant( item->child( child ) ) )
+        {
+            return true;
+        }
+    }
+    return false;
+}
+
+QStringList LinxiraSoftwareViewStep::selectedBundleIds() const
+{
+    QStringList selected;
+    for ( auto* tree : { m_desktops, m_applications, m_components } )
+    {
+        if ( !tree )
+        {
+            continue;
+        }
+        QList< QTreeWidgetItem* > pending;
+        for ( int row = 0; row < tree->topLevelItemCount(); ++row )
+        {
+            pending.append( tree->topLevelItem( row ) );
+        }
+        while ( !pending.isEmpty() )
+        {
+            auto* item = pending.takeLast();
+            const auto kind = item->data( 0, KindRole ).toString();
+            if ( ( kind == QStringLiteral( "category" ) || kind == QStringLiteral( "bundle" ) )
+                 && hasSelectedLeafDescendant( item ) )
+            {
+                selected.append( item->data( 0, IdRole ).toString() );
+            }
+            for ( int child = 0; child < item->childCount(); ++child )
+            {
+                pending.append( item->child( child ) );
+            }
+        }
+    }
+    selected.removeDuplicates();
+    selected.sort();
+    return selected;
+}
+
+void LinxiraSoftwareViewStep::restoreSelection()
+{
+    auto* storage = Calamares::JobQueue::instanceGlobalStorage();
+    if ( !storage || !storage->contains( m_storageKey ) )
+    {
+        return;
+    }
+    const auto selected = storage->value( m_storageKey ).toMap().value(
+        QStringLiteral( "selectedLeafIds" ) ).toStringList();
+    m_updating = true;
+    for ( const auto& id : selected )
+    {
+        for ( auto* item : m_leafItems.value( id ) )
+        {
+            if ( item->data( 0, SelectableRole ).toBool() )
+            {
+                item->setCheckState( 0, Qt::Checked );
+            }
+        }
+    }
+    normalizeExclusiveCategories();
+    m_updating = false;
+    updateStatus();
+}
+
+void LinxiraSoftwareViewStep::normalizeExclusiveCategories()
+{
+    for ( auto* tree : { m_desktops, m_applications, m_components } )
+    {
+        for ( int row = 0; tree && row < tree->topLevelItemCount(); ++row )
+        {
+            auto* category = tree->topLevelItem( row );
+            if ( category->data( 0, CategorySelectionRole ).toString() != QStringLiteral( "exclusive" ) )
+            {
+                continue;
+            }
+            QTreeWidgetItem* selectedChoice = nullptr;
+            for ( int child = 0; child < category->childCount(); ++child )
+            {
+                auto* choice = category->child( child );
+                if ( !selectedChoice && choice->checkState( 0 ) != Qt::Unchecked )
+                {
+                    selectedChoice = choice;
+                }
+                else if ( choice->checkState( 0 ) != Qt::Unchecked )
+                {
+                    choice->setCheckState( 0, Qt::Unchecked );
+                }
+            }
+        }
+    }
+}
+
+bool LinxiraSoftwareViewStep::selectionValid() const
+{
+    int selectedDesktops = 0;
+    for ( const auto& id : selectedLeafIds() )
+    {
+        if ( m_nodes.value( id ).value( QStringLiteral( "kind" ) ).toString()
+             == QStringLiteral( "desktop" ) )
+        {
+            ++selectedDesktops;
+        }
+    }
+    if ( selectedDesktops != 1 )
+    {
+        return false;
+    }
+    for ( auto* tree : { m_desktops, m_applications, m_components } )
+    {
+        for ( int row = 0; tree && row < tree->topLevelItemCount(); ++row )
+        {
+            auto* category = tree->topLevelItem( row );
+            int selectedChoices = 0;
+            for ( int child = 0; child < category->childCount(); ++child )
+            {
+                selectedChoices += hasSelectedLeafDescendant( category->child( child ) );
+            }
+            const auto mode = category->data( 0, CategorySelectionRole ).toString();
+            if ( mode == QStringLiteral( "exclusive" ) && selectedChoices > 1 )
+            {
+                return false;
+            }
+            if ( mode == QStringLiteral( "bounded" )
+                 && selectedChoices > category->data( 0, CategoryMaximumRole ).toInt() )
+            {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+void LinxiraSoftwareViewStep::updateStatus()
+{
+    if ( m_status )
+    {
+        m_status->setText(
+            selectionValid()
+                ? tr( "%1 items selected. Included items are installed now; other choices remain pending." )
+                      .arg( selectedLeafIds().size() )
+                : tr( "Choose exactly one desktop; application and runtime choices are optional." ) );
+    }
+    emit nextStatusChanged( m_ready && selectionValid() );
+}
