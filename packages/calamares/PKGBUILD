# Maintainer: Linxira OS <admin@linxira.org>

pkgname=calamares
pkgver=3.3.14
pkgrel=9
pkgdesc='Distribution-independent graphical system installer framework'
arch=('x86_64')
url='https://calamares.io/'
license=('BSD-2-Clause' 'CC-BY-SA-4.0' 'GPL-3.0-or-later' 'LGPL-2.1-or-later')
depends=(
  'boost-libs'
  'hwinfo'
  'kconfig'
  'kcoreaddons'
  'kcrash'
  'ki18n'
  'kiconthemes'
  'kpmcore'
  'kservice'
  'kwidgetsaddons'
  'libpwquality'
  'parted'
  'polkit-qt6'
  'python'
  'qt6-declarative'
  'qt6-svg'
  'qt6-tools'
  'qt6-wayland'
  'yaml-cpp'
)
makedepends=(
  'boost'
  'cmake'
  'extra-cmake-modules'
  'ninja'
)
options=('!debug')
source=(
  "https://github.com/calamares/calamares/releases/download/v${pkgver}/calamares-${pkgver}.tar.gz"
  '0001-initcpiocfg-drop-obsolete-crc32c-intel.patch'
  '0002-add-linxira-software-viewmodule.patch'
  '0003-add-linxira-about-links.patch'
)
sha256sums=('5547f80db067dea923ae693ba6bb88eb2b2eeac1da3ebec42fce453e31c290c0'
            '0231ff9d671cc590f96b863c69c341a1fca45f260ba79ed246b8a5b95fe0859d'
            '66aaf7e5c6daa176ae2a976606d01e505553fc2ae7610af838bf80a71dd5561b'
            '09c4431c16d26d122e19656f5207e52aa2d8328f063398facad7eb41d5056aea')

prepare() {
  cd "calamares-${pkgver}"
  patch --no-backup-if-mismatch -Np1 \
    -i "${srcdir}/0001-initcpiocfg-drop-obsolete-crc32c-intel.patch"
  patch --no-backup-if-mismatch -Np1 \
    -i "${srcdir}/0002-add-linxira-software-viewmodule.patch"
  patch --no-backup-if-mismatch -Np1 \
    -i "${srcdir}/0003-add-linxira-about-links.patch"
  ! grep -R -q -E 'crc32c[-_]intel' src/modules/initcpiocfg
}

build() {
  CFLAGS+=" -ffile-prefix-map=${srcdir}=/usr/src/debug/${pkgname}"
  CXXFLAGS+=" -ffile-prefix-map=${srcdir}=/usr/src/debug/${pkgname}"

  cmake -S "calamares-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DINSTALL_COMPLETION=ON \
    -DINSTALL_CONFIG=OFF \
    -DWITH_PYTHON=ON \
    -DWITH_PYBIND11=ON \
    -DWITH_QML=ON \
    -DWITH_QT6=ON \
    -DBUILD_TESTING=OFF \
    -Wno-dev
  cmake --build build
}

check() {
  local module_build="build/src/modules/linxirasoftware"

  # These files only exist when upstream's module traversal registered and built the plugin.
  test -s "$module_build/libcalamares_viewmodule_linxirasoftware.so"
  grep -Fxq 'type: "viewmodule"' "$module_build/module.desc"
  grep -Fxq 'name: "linxirasoftware"' "$module_build/module.desc"
  grep -Fxq 'interface: "qtplugin"' "$module_build/module.desc"
  grep -Fxq 'load: "libcalamares_viewmodule_linxirasoftware.so"' "$module_build/module.desc"
  grep -Fxq 'catalogPath: "/usr/share/linxira/catalog/catalog-v3.json"' \
    "$module_build/linxirasoftware.conf"
  grep -Fq 'catalogVersion" ) ).toInt() != 3' \
    "calamares-${pkgver}/src/modules/linxirasoftware/LinxiraSoftwareViewStep.cpp"
  grep -Fq 'QStringLiteral( "exclusive" )' \
    "calamares-${pkgver}/src/modules/linxirasoftware/LinxiraSoftwareViewStep.cpp"
  grep -Fq 'org.linxira.installer-selection.v1' \
    "calamares-${pkgver}/src/modules/linxirasoftware/LinxiraSoftwareViewStep.cpp"
  grep -Fq 'QStringLiteral( "desktops" )' \
    "calamares-${pkgver}/src/modules/linxirasoftware/LinxiraSoftwareViewStep.cpp"
  grep -Fq 'QStringLiteral( "bounded" )' \
    "calamares-${pkgver}/src/modules/linxirasoftware/LinxiraSoftwareViewStep.cpp"
  grep -Fq 'https://github.com/Linxira-OS/linxira-iso-direct/issues' \
    "calamares-${pkgver}/src/libcalamares/CalamaresAbout.cpp"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  rm -f "$pkgdir/usr/share/applications/calamares.desktop"
  install -Dm644 "calamares-${pkgver}/LICENSES/BSD-2-Clause.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/BSD-2-Clause.txt"

  local module_dir="$pkgdir/usr/lib/calamares/modules/linxirasoftware"
  test -s "$module_dir/libcalamares_viewmodule_linxirasoftware.so"
  test -s "$module_dir/module.desc"
  test -s "$pkgdir/usr/share/calamares/modules/linxirasoftware.conf"
  grep -Fxq 'load: "libcalamares_viewmodule_linxirasoftware.so"' "$module_dir/module.desc"
  grep -Fxq 'catalogPath: "/usr/share/linxira/catalog/catalog-v3.json"' \
    "$pkgdir/usr/share/calamares/modules/linxirasoftware.conf"
  test ! -e "$pkgdir/usr/share/applications/calamares.desktop"
}
