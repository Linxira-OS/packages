# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-keyring
pkgver=20260804
pkgrel=2
pkgdesc='Linxira OS package signing keyring (trusted release key)'
arch=('any')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-keyring'
license=('GPL-3.0-or-later')
install=keyring.install

_commit=E1A4155F457D1481CA85EE6BF9D157739534BC29
source=(linxira.gpg)
sha256sums=('99196cbbc98883d9c080e6b44f456df6453803786f6950f7f3bae12248b17ab5')

package() {
  install -Dm644 linxira.gpg "$pkgdir/usr/share/keyrings/linxira.gpg"
  printf '%s\n' "${_commit}" > "$pkgdir/usr/share/keyrings/linxira-release-fingerprint"
}
