#!/bin/bash
# Import and locally sign the Linxira OS release signing key so pacman
# accepts [linxira] repository signatures.

post_install() {
  if [ -x /usr/bin/pacman-key ]; then
    pacman-key --add /usr/share/keyrings/linxira.gpg >/dev/null 2>&1 || true
    pacman-key --lsign-key E1A4155F457D1481CA85EE6BF9D157739534BC29 >/dev/null 2>&1 || true
  fi
}

post_upgrade() {
  post_install
}

post_remove() {
  : # Key removal is left to the administrator (pacman-key --delete).
}
