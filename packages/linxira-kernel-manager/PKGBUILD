# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-kernel-manager
pkgver=0.1.1
pkgrel=1
pkgdesc='Fixed-policy kernel, boot, and initramfs reporting for Linxira OS'
arch=('any')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-kernel-manager'
license=('MIT')
depends=('grub' 'pacman' 'python' 'pyside6')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('appstream' 'desktop-file-utils')
optdepends=('dkms: report exact per-kernel DKMS module status')

_commit=203a02b58a1296ec7f191884e2d3657c7716ea9c
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/Linxira-OS/$pkgname/tar.gz/$_commit")
sha256sums=('8931254fe7d4dbed8658f76e7decc8e40c0d45cfa3c51c5544ff8c0c68e608d1')

build() {
  cd "$srcdir/$pkgname-$_commit"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/$pkgname-$_commit"
  [[ $(<VERSION) == "$pkgver" ]]
  PYTHONPATH=src:tests QT_QPA_PLATFORM=offscreen python -m unittest discover -s tests -v
  python -m compileall -q src tests
  desktop-file-validate data/org.linxira.KernelManager.desktop
  appstreamcli validate --no-net data/org.linxira.KernelManager.metainfo.xml
  ! grep -R -E -n 'shell=True|os\.system|sudo|pkexec' src
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
