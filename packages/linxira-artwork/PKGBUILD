# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-artwork
pkgver=1.0.3
pkgrel=5
pkgdesc='Canonical artwork and visual identity for Linxira OS'
arch=('any')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-artwork'
license=('GPL-3.0-or-later')

_commit=8b92b66655770a991cfe35d2ca327407630e364c
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/Linxira-OS/$pkgname/tar.gz/$_commit"
        'linxira-logo-braille60.ansi')
sha256sums=('fced177af3a59795c22f6927cf137b4b510aa124d3e0afd5bceed0ca4f2e8ca6'
            'f2f4c61c2a2f1e131e388a8a2ad9cb12e3b8746278deee3499416f9141e6c7ba')

package() {
  cd "$srcdir/$pkgname-$_commit"
  cp -a usr "$pkgdir/"
  install -Dm644 assets/logo/linxira-l.svg \
    "$pkgdir/usr/share/linxira/linxira-logo.svg"
  install -Dm644 assets/logo/linxira-l.svg \
    "$pkgdir/usr/share/linxira/linxira-icon.svg"
  install -Dm644 "$srcdir/linxira-logo-braille60.ansi" \
    "$pkgdir/usr/share/linxira/linxira-logo-braille60.ansi"
  install -Dm644 assets/logo/linxira-l.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/linxira.svg"
  install -Dm644 TRADEMARKS.md \
    "$pkgdir/usr/share/doc/linxira-artwork/TRADEMARKS.md"
  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/linxira-artwork/LICENSE"
}
