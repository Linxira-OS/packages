# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-hardware-driver-manager
pkgver=0.3.0
pkgrel=1
pkgdesc='Hardware driver reporting, fixed planning, and root-owned diagnostics for Linxira OS'
arch=('any')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-hardware-driver-manager'
license=('MIT')
depends=('linxira-chwd-detector' 'linxira-components>=0.6.0' 'pacman' 'python' 'python-dbus' 'pyside6')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('appstream' 'desktop-file-utils')
optdepends=('dkms: report DKMS module build status')

_commit=1cc3eb3040bea48a68b83e0b4f4ddfac32b510ff
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/Linxira-OS/$pkgname/tar.gz/$_commit")
sha256sums=('f5382ff2d1612545f83712876d34f9aa18ebde6c3603191c8963538f4d1f31f5')

build() {
  cd "$srcdir/$pkgname-$_commit"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/$pkgname-$_commit"
  [[ $(<VERSION) == "$pkgver" ]]
  PYTHONPATH=src:tests QT_QPA_PLATFORM=offscreen python -m unittest discover -s tests -v
  python -m compileall -q src
  desktop-file-validate data/org.linxira.HardwareDriverManager.desktop
  appstreamcli validate --no-net data/org.linxira.HardwareDriverManager.metainfo.xml
  ! grep -R -E -n 'shell=True|bash -c|sudo|pkexec|pacman -S|pacman -R' src
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
