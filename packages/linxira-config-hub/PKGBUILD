# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-config-hub
pkgver=2.2.1
pkgrel=3
pkgdesc='Configuration and diagnostics CLI for Linxira OS'
arch=('any')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-config-hub'
license=('MIT')
depends=(
  'bash' 'coreutils' 'curl' 'gawk' 'grep' 'iproute2' 'jq' 'pacman'
  'pciutils' 'procps-ng' 'sed' 'sudo' 'systemd' 'util-linux'
  'linxira-catalog'
)
optdepends=(
  'bind: DNS diagnostics'
  'flatpak: manage explicitly enabled Flatpak remotes'
  'git: configure AUR source access'
  'go: manage Go module proxy settings'
  'iputils: network diagnostics'
  'networkmanager: NetworkManager status and DNS operations'
  'nodejs: Node.js runtime status'
  'npm: npm registry management'
  'openssh: SSH client and server workflows'
  'ufw: firewall status and configuration'
)
checkdepends=('python')

_commit=d5bb6bb094fd43999fa51488dc44bb47bb63fea1
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/Linxira-OS/$pkgname/tar.gz/$_commit")
sha256sums=('129b4e486082dae83bdafd4b12c7b49c240ae864cec025910a3818fedbe80f8d')

check() {
  cd "$srcdir/$pkgname-$_commit"
  grep -q 'VERSION="2.2.1"' cli/linxira-config
  bash -n cli/linxira-config
  python -m unittest discover -s tests -v
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  install -Dm755 cli/linxira-config "$pkgdir/usr/bin/linxira-config"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
