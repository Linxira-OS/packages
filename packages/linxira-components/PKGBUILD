# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-components
pkgver=0.2.0
pkgrel=3
pkgdesc='Catalog-bound transaction planning and receipt backend for Linxira OS'
arch=('any')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-components'
license=('MIT')
depends=('python' 'pacman' 'linxira-catalog')

_commit=d27e011967908e85484f025ad1a4ee196a251d24
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/Linxira-OS/$pkgname/tar.gz/$_commit")
sha256sums=('b95624eca862ee2416ffc24225b55e4ee3fd210983c8fe33bbcdd9dff947c68d')

check() {
  cd "$srcdir/$pkgname-$_commit"
  python -m unittest discover -s tests -v
  python -m compileall -q src tests
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  install -Dm755 scripts/linxira-components \
    "$pkgdir/usr/bin/linxira-components"
  install -d "$pkgdir/usr/lib/linxira-components"
  cp -a src/linxira_components "$pkgdir/usr/lib/linxira-components/"
  find "$pkgdir/usr/lib/linxira-components" -type d -name __pycache__ \
    -prune -exec rm -rf {} +
  find "$pkgdir/usr/lib/linxira-components" -type f -name '*.pyc' -delete
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
