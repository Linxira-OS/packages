# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-components
pkgver=0.7.0
pkgrel=2
pkgdesc='Catalog-bound transaction planning and receipt backend for Linxira OS'
arch=('any')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-components'
license=('MIT')
depends=(
  'btrfs-progs' 'dbus' 'linxira-catalog' 'linxira-chwd-detector' 'pacman' 'polkit'
  'python' 'python-dbus' 'python-gobject' 'pyalpm' 'systemd' 'timeshift' 'util-linux'
)
checkdepends=('python-pytest')

_commit=477b5d1f7111b7f9c6e095f6613aa423c401f020
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/Linxira-OS/$pkgname/tar.gz/$_commit")
sha256sums=('67bc54e294afb67e05708c126f22d085eb8512989cbfd37b3944f9f823f6cbb5')

check() {
  cd "$srcdir/$pkgname-$_commit"
  grep -q 'version = "0.7.0"' pyproject.toml
  python -m unittest discover -s tests -v
  PYTHONPATH=src dbus-run-session python -m pytest -q tests/test_dbus_service.py
  PYTHONPATH=src python - <<'PY'
from pathlib import Path
import tempfile
import pyalpm
from linxira_components.driver_worker import _package_artifacts, _sync_metadata
from linxira_components.system_transactions import SystemTransactionStore

hyperv = _sync_metadata(Path("/"))["hyperv"]
assert len(hyperv["sha256"]) == 64
assert len(hyperv["signatureSha256"]) == 64

with tempfile.TemporaryDirectory() as state_directory:
    store = SystemTransactionStore(Path(state_directory), Path("/"), recover=False)
    for targets in (("qemu-guest-agent", "spice-vdagent"), ("open-vm-tools",)):
        artifacts = _package_artifacts(Path("/"), store._run_fixed, targets)
        assert set(targets).issubset({item["name"] for item in artifacts})
        assert all(len(item["sha256"]) == 64 and len(item["signatureSha256"]) == 64 for item in artifacts)

with tempfile.TemporaryDirectory() as directory:
    root = Path(directory) / "root"
    database = Path(directory) / "db"
    root.mkdir()
    (database / "local").mkdir(parents=True)
    handle = pyalpm.Handle(str(root), str(database))
    transaction = handle.init_transaction()
    assert (database / "db.lck").exists()
    transaction.release()
    assert not (database / "db.lck").exists()
PY
  python -m compileall -q src tests
  python - <<'PY'
import xml.etree.ElementTree as ET
for path in (
    "api/org.linxira.Components1.xml",
    "policy/org.linxira.components.policy.in",
    "service/org.linxira.Components1.conf",
):
    ET.parse(path)
PY
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  install -Dm755 scripts/linxira-components \
    "$pkgdir/usr/bin/linxira-components"
  install -Dm755 scripts/linxira-components-service \
    "$pkgdir/usr/bin/linxira-components-service"
  install -Dm755 scripts/linxira-components-worker \
    "$pkgdir/usr/bin/linxira-components-worker"
  install -d "$pkgdir/usr/lib/linxira-components"
  cp -a src/linxira_components "$pkgdir/usr/lib/linxira-components/"
  find "$pkgdir/usr/lib/linxira-components" -type d -name __pycache__ \
    -prune -exec rm -rf {} +
  find "$pkgdir/usr/lib/linxira-components" -type f -name '*.pyc' -delete
  install -Dm644 api/org.linxira.Components1.xml \
    "$pkgdir/usr/share/dbus-1/interfaces/org.linxira.Components1.xml"
  install -Dm644 service/org.linxira.Components1.conf \
    "$pkgdir/usr/share/dbus-1/system.d/org.linxira.Components1.conf"
  install -Dm644 service/org.linxira.Components1.service \
    "$pkgdir/usr/share/dbus-1/system-services/org.linxira.Components1.service"
  install -Dm644 service/linxira-components.service \
    "$pkgdir/usr/lib/systemd/system/linxira-components.service"
  install -Dm644 service/linxira-components-worker@.service \
    "$pkgdir/usr/lib/systemd/system/linxira-components-worker@.service"
  install -Dm644 policy/org.linxira.components.policy.in \
    "$pkgdir/usr/share/polkit-1/actions/org.linxira.components.policy"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
