# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-package-center
pkgver=0.2.1
pkgrel=1
pkgdesc='Catalog-bound application and capability manager for Linxira OS'
arch=('any')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-package-center'
license=('MIT')
depends=(
  'python' 'pyside6' 'polkit'
  'linxira-catalog' 'linxira-components'
)
checkdepends=('desktop-file-utils')

_commit=f49c7790416ae2c7b1677b58f81205bd01c87944
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/Linxira-OS/$pkgname/tar.gz/$_commit")
sha256sums=('5610d6bd239b931c711730f26f12737cf5c2c69fa5cd99bf5abec75fdbfa683e')

check() {
  cd "$srcdir/$pkgname-$_commit"
  [[ $(<VERSION) == "$pkgver" ]]
  python -m py_compile src/linxira-package-center
  QT_QPA_PLATFORM=offscreen python -m unittest discover -s tests -v
  desktop-file-validate data/org.linxira.PackageCenter.desktop
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  install -Dm755 src/linxira-package-center \
    "$pkgdir/usr/bin/linxira-package-center"
  install -Dm644 data/org.linxira.PackageCenter.desktop \
    "$pkgdir/usr/share/applications/org.linxira.PackageCenter.desktop"
  install -Dm644 VERSION \
    "$pkgdir/usr/share/linxira/package-center/VERSION"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
