# Maintainer: Linxira OS <admin@linxira.org>
# Prebuilt Zeta desktop shell: the Electron app is assembled by
# Linxira-OS/linxira-zeta CI (electron-builder), so this package fetches the
# signed release tarball instead of building the ~200k-line web/runtime stack.
# 2026-10-03: 自 zetabin 改名（pkgver 17.2.12 旧线退役, 1.1.x 起跟随上游）,
# assets 模式由 upstream-sync 追踪版本与校验和。

pkgname=linxira-zeta-desktop-bin
pkgver=1.2.1
pkgrel=1
pkgdesc='Zeta coding agent desktop shell: embedded Web UI + local service (no terminal, no system browser)'
arch=('x86_64')
url='https://github.com/Linxira-OS/linxira-zeta'
license=('MIT')
depends=(
  'at-spi2-core'
  'gtk3'
  'libnotify'
  'libsecret'
  'libxss'
  'libxtst'
  'nss'
  'util-linux'
  'xdg-utils'
)
options=('!strip' '!debug')  # 上游预编译二进制: 无调试符号可分发, 避免 -debug 拆包 build-id 冲突
provides=('zeta-desktop' 'zetabin')
conflicts=('zeta-desktop' 'zetabin')
replaces=('zetabin')

source=("zeta-desktop-${pkgver}-linux-x64.tar.gz::https://github.com/Linxira-OS/linxira-zeta/releases/download/v${pkgver}/zeta-desktop-${pkgver}-linux-x64.tar.gz"
"LICENSE::https://github.com/Linxira-OS/linxira-zeta/releases/download/v${pkgver}/LICENSE"
"THIRD-PARTY-NOTICES.txt::https://github.com/Linxira-OS/linxira-zeta/releases/download/v${pkgver}/THIRD-PARTY-NOTICES.txt"
)
# assets 模式: sha256 由 scripts/sync-upstream.py 从上游 SHA256SUMS.txt 自动回填
sha256sums=('8ce685600c2823c3464f86d1066a9f14d243fe7fd9a219a8a5cf91d461afe717'
'dc4eb64d767658a18fc64ea98344ac86365564196f61df33b76c5871fe3a844f'
'4cbd0fe43423d59c288501fa74c8a041194d5a39ab094a7d705cf8aed95296ea'
)

# 1.1.26 起 tar 内条目位于版本化子目录 zeta-desktop-${pkgver}-linux-x64/

check() {
  local _dir="$srcdir/zeta-desktop-${pkgver}-linux-x64"
  # 上游 CI 在非 Linux 打包, tar 内执行位丢失 —— 先补再验
  chmod +x "$_dir/zeta-desktop"
  [[ -x "$_dir/zeta-desktop" ]]
  file "$_dir/zeta-desktop" | grep -q ELF
}

package() {
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/THIRD-PARTY-NOTICES.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
  local _dir="$srcdir/zeta-desktop-${pkgver}-linux-x64"
  install -d "$pkgdir/opt/zeta"
  cp -a "$_dir/resources" "$pkgdir/opt/zeta/"
  install -Dm755 "$_dir/zeta-desktop" "$pkgdir/opt/zeta/zeta-desktop"
  install -dm755 "$pkgdir/usr/bin"
  ln -s /opt/zeta/zeta-desktop "$pkgdir/usr/bin/zeta-desktop"
}
