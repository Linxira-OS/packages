# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-recovery-diagnostics
pkgver=0.2.0
pkgrel=1
pkgdesc='Read-only recovery readiness, repair planning, and support bundles for Linxira OS'
arch=('any')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-recovery-diagnostics'
license=('MIT')
depends=(
  'linxira-components>=0.4.0' 'pacman' 'python' 'python-dbus' 'pyside6'
  'systemd' 'util-linux'
)
makedepends=('python-build' 'python-hatchling' 'python-installer')
checkdepends=('appstream' 'desktop-file-utils' 'python-pytest')
optdepends=(
  'arch-install-scripts: inspect fixed live chroot readiness'
  'grub-btrfs: inspect snapshot boot integration'
  'timeshift: inspect snapshot configuration and inventory'
)

_commit=badc0f75e4b31453fa11376caf985c2314eb1792
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/Linxira-OS/$pkgname/tar.gz/$_commit")
sha256sums=('31db718145af2c9b67019ec70f999c8c0ac0fc31154b36573afb604943dd6326')

build() {
  cd "$srcdir/$pkgname-$_commit"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/$pkgname-$_commit"
  [[ $(<VERSION) == "$pkgver" ]]
  PYTHONPATH=src QT_QPA_PLATFORM=offscreen python -m pytest -q
  python -m compileall -q src tests
  desktop-file-validate data/org.linxira.RecoveryDiagnostics.desktop
  appstreamcli validate --no-net data/org.linxira.RecoveryDiagnostics.metainfo.xml
  ! grep -R -E -n 'shell=True|os\.system|sudo|pkexec' src
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
