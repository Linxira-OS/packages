# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-welcome
pkgver=1.0.0
pkgrel=3
pkgdesc='Safe Plasma-native workstation control center for Linxira OS'
arch=('any')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-welcome'
license=('MIT')
depends=('python' 'pyside6' 'linxira-catalog')
checkdepends=('desktop-file-utils')
optdepends=(
  'calamares: install Linxira OS from the live environment'
  'kinfocenter: inspect system information'
  'konsole: open a terminal'
  'linxira-config-hub: administrator configuration and diagnostics'
  'linxira-component-manager: select capability bundles and system components'
  'linxira-package-center: install reviewed applications'
  'shelly: manage software after installation'
  'systemsettings: configure Plasma'
  'timeshift: manage recovery snapshots'
)

_commit=b5bfa4f22d3a37498d54970a0c51d2503f2547ed
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/Linxira-OS/$pkgname/tar.gz/$_commit")
sha256sums=('6e269e7edbb40a0cc7e5a4ac291ff421731cd37c5dc5c6692d410b0e5f688ec6')

check() {
  cd "$srcdir/$pkgname-$_commit"
  python -m py_compile src/linxira-welcome
  python -m unittest discover -s tests -v
  desktop-file-validate data/org.linxira.Welcome.desktop
  desktop-file-validate data/autostart/org.linxira.Welcome.desktop
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  install -Dm755 src/linxira-welcome "$pkgdir/usr/bin/linxira-welcome"
  install -Dm644 data/org.linxira.Welcome.desktop \
    "$pkgdir/usr/share/applications/org.linxira.Welcome.desktop"
  install -Dm644 data/autostart/org.linxira.Welcome.desktop \
    "$pkgdir/etc/xdg/autostart/org.linxira.Welcome.desktop"
  install -Dm644 data/i18n/*.json -t "$pkgdir/usr/share/linxira/welcome/i18n"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
