# Maintainer: Linxira OS <admin@linxira.org>
# Release-asset repackage: assets 模式由 upstream-sync 追踪(SHA256SUMS.txt 回填)。
# 分发走 [linxira-zeta] 仓库(packages 仓库 Release 资产), 不进 linxira-packages git(100MB 限制)。

pkgname=linxira-zetawork
pkgver=1.3.2
pkgrel=1
pkgdesc='Zeta workbench: nested-terminal workspace (release binary)'
arch=('x86_64')
url='https://github.com/Linxira-OS/linxira-zeta'
license=('MIT')
options=('!strip' '!debug')
provides=('zetawork')
source=("zeta-work-linux-x64::https://github.com/Linxira-OS/linxira-zeta/releases/download/v${pkgver}/zeta-work-linux-x64")
# assets 模式: sha256 由 sync-upstream.py 自动回填; 资产未上传前为 SKIP(构建跳过)
sha256sums=('28c5ca28ee5c0d89110141c9311525ac108c21789d5ad37a2ff18c88972893c7')

check() {
  chmod +x "$srcdir/zeta-work-linux-x64"
  head -c 4 "$srcdir/zeta-work-linux-x64" | grep -q $'\x7fELF'
}

package() {
  install -Dm755 "$srcdir/zeta-work-linux-x64" "$pkgdir/usr/bin/zetawork"
}
