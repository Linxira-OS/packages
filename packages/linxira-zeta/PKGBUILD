# Maintainer: Linxira OS <admin@linxira.org>
#
# The Linxira Zeta family package. This name used to be the retired Work Studio
# Electron desktop; it is now the suite entry point so an existing install
# upgrades in place and the old desktop/WebUI/Rust GUI packages are removed.
#
# Components stay separately packaged: the CLI, the IDE, and (once its
# AppImage/pacman artifact is published) Zeta Terminal. Exact versions keep a
# pacman transaction from mixing suite releases.

pkgname=linxira-zeta
pkgver=1.5.15
pkgrel=1
pkgdesc='Linxira Zeta suite: zetacode, zetaide and Zeta Terminal'
arch=('any')
url='https://github.com/Linxira-OS/linxira-zeta'
license=('MIT')
depends=('linxira-zeta-c-bin>=1.5.15' 'linxira-zeta-ide>=1.5.15')
optdepends=('linxira-zeta-terminal: Zeta Terminal (AppImage/pacman)')
# Old surfaces this name replaces on pacman -Syu. `linxira-zeta` itself is the
# same package id, so the old desktop payload is removed by the normal upgrade.
conflicts=('linxira-zetawork' 'zetabin' 'linxira-zeta-desktop-bin' 'linxira-zeta-editor')
replaces=('linxira-zetawork' 'zetabin' 'linxira-zeta-desktop-bin' 'linxira-zeta-editor')
provides=('zeta-suite')

package() {
  install -dm755 "$pkgdir"
}
