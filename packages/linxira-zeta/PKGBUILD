# Maintainer: Linxira OS <admin@linxira.org>
#
# Zeta 桌面壳(Electron): 内嵌 Work Studio 渲染器 + 本地 zeta serve 服务,
# 目标机无需 Node/Bun/浏览器。上游 release 的 linux-x64 tar.gz 重打包。
#
# 2026-11-10: 上游换了桌面(旧 zetawork TUI+GUI 的 Arch 包资产已停产,
# v1.5.0 起改为 zeta-desktop-<ver>-linux-x64.tar.gz)。本包随之切换资产,
# pkgname 不变 —— 已装机(r2 预装 1.4.10)经 pacman -Syu 直接换到新桌面。
# 旧版提供的 zetawork 不再随包分发; CLI(zetacode)/IDE 仍是独立按需包。
#
# 许可: 上游分层许可(见随包 legal/LICENSE)——desktop/ 与 packages/coding-agent
# 均 MIT, 本包只含 MIT 部分; AGPL 的 main/(zetawork)不在本资产内。
#
# 为什么不进主仓库: 包体远超 GitHub 单文件 100MB 上限; 本包发布到
# 独立滚动仓库([linxira-zeta], GitHub Release 资产, 单文件上限 2GB)。

pkgname=linxira-zeta
pkgver=1.5.1
pkgrel=1
pkgdesc='Zeta desktop shell (embedded Work Studio + local agent service) — upstream release repacked'
arch=('x86_64')
url='https://github.com/Linxira-OS/linxira-zeta'
license=('MIT')
# Electron 运行时: 与上游 deb 的 Depends 对齐, 另加音频/键盘/GPU 运行库
# (mesa 保证 Hyper-V 无 GPU 的 llvmpipe 路径也有软件 GL)。
depends=('gtk3' 'nss' 'alsa-lib' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core'
         'util-linux-libs' 'libsecret' 'libnotify' 'libxkbcommon' 'libdrm'
         'mesa' 'libglvnd' 'glibc' 'gcc-libs')
optdepends=('libappindicator-gtk3: tray icon support')
conflicts=('linxira-zetawork')
replaces=('linxira-zetawork')
# 上游已编译: 不 strip、不拆 debug(Electron 拆包不可复现且体积翻倍)
options=('!strip' '!debug')

source=("zeta-desktop-${pkgver}-linux-x64.tar.gz::https://github.com/Linxira-OS/linxira-zeta/releases/download/v${pkgver}/zeta-desktop-${pkgver}-linux-x64.tar.gz")
# assets 模式: sha256 由 scripts/sync-upstream.py 从上游 SHA256SUMS.txt 自动回填
sha256sums=('fc359eebbfa2bcae359dad11ddab70537a30ed1888e2762ca0912d0532325014')

check() {
  head -c 4 "$srcdir/zeta-desktop-${pkgver}-linux-x64/zeta-desktop" | grep -q $'\x7fELF'
}

package() {
  local unpacked="$srcdir/zeta-desktop-${pkgver}-linux-x64"
  [[ -x $unpacked/zeta-desktop ]] || { echo "missing desktop executable: $unpacked/zeta-desktop" >&2; exit 1; }

  install -d "$pkgdir/opt/linxira-zeta"
  cp -a "$unpacked/." "$pkgdir/opt/linxira-zeta/"
  # 空载荷必须让构建失败(1.4.3-1 曾发布成 2.9KB 空包)。
  if [[ -z $(find "$pkgdir/opt/linxira-zeta" -type f -print -quit) ]]; then
    echo "upstream archive extracted to an empty payload" >&2
    exit 1
  fi
  # Chromium 沙箱要求 SUID root(fakeroot 下 chmod 会被 pacman 记录)。
  chmod 4755 "$pkgdir/opt/linxira-zeta/chrome-sandbox"

  install -d "$pkgdir/usr/bin"
  ln -s /opt/linxira-zeta/zeta-desktop "$pkgdir/usr/bin/zeta-desktop"

  install -Dm644 "$unpacked/resources/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/linxira-zeta.png"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/linxira-zeta.desktop" <<'EOF'
[Desktop Entry]
Name=Zeta
Comment=Zeta coding agent desktop
Exec=zeta-desktop %U
Terminal=false
Type=Application
Icon=linxira-zeta
StartupWMClass=zeta-desktop
Categories=Development;
MimeType=x-scheme-handler/zeta;
EOF

  install -Dm644 "$unpacked/resources/legal/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$unpacked/resources/legal/THIRD-PARTY-NOTICES.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
}