# Maintainer: Linxira OS <admin@linxira.org>
# Zeta 套件元包: 五件全装(work/ide/editor/c/desktop)。随 zeta-stack job 构建,
# 分发走 [linxira-zeta] 仓库(packages 仓库 Release 资产)。

pkgname=linxira-zeta
pkgver=1.1.26
pkgrel=1
pkgdesc='Zeta terminal workbench suite (meta: workbench + IDE + editor + coding agent + desktop)'
arch=('any')
url='https://github.com/Linxira-OS/linxira-zeta'
license=('MIT')
depends=(
  'linxira-zetawork'
  'linxira-zeta-ide'
  'linxira-zeta-editor'
  'linxira-zeta-c-bin'
  'linxira-zeta-desktop-bin'
)

package() {
  install -d "$pkgdir/usr/share/doc/linxira-zeta"
  cat > "$pkgdir/usr/share/doc/linxira-zeta/README.md" <<'EOF'
# Zeta Suite
zeta --help / zeta doctor 查看套件状态; 各工具可独立 --help。
EOF
}
