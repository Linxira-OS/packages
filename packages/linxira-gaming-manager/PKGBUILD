# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-gaming-manager
pkgver=0.1.0
pkgrel=1
pkgdesc='User-level game library and compatibility manager for Linxira OS'
arch=('any')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-gaming-manager'
license=('MIT')
depends=('python' 'python-vdf' 'pyside6')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('appstream' 'desktop-file-utils')
optdepends=(
  'gamemode: optimized game launch wrapper'
  'gamescope: game-focused compositor'
  'protontricks: manage Steam Proton prefixes'
  'restic: encrypted prefix and save backups'
  'steam: Steam library discovery and launching'
  'umu-launcher: non-Steam Proton execution when available'
  'wine: Wine prefix execution'
  'winetricks: reviewed Wine prefix operations'
)

_commit=9569e94634050a7ddc7c439b07595ddf5037a81e
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/Linxira-OS/$pkgname/tar.gz/$_commit")
sha256sums=('afc3e03c7df79af893c4d64fd2320476d6c731551557e74dd24157b2f717632d')

build() {
  cd "$srcdir/$pkgname-$_commit"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/$pkgname-$_commit"
  [[ $(<VERSION) == "$pkgver" ]]
  PYTHONPATH=src python -m unittest discover -s tests -v
  python -m compileall -q src
  desktop-file-validate data/org.linxira.GamingManager.desktop
  appstreamcli validate --no-net data/org.linxira.GamingManager.metainfo.xml
  ! grep -R -E -n 'pkexec|sudo|pacman|flatpak|shell=True' src
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 data/org.linxira.GamingManager.desktop \
    "$pkgdir/usr/share/applications/org.linxira.GamingManager.desktop"
  install -Dm644 data/org.linxira.GamingManager.metainfo.xml \
    "$pkgdir/usr/share/metainfo/org.linxira.GamingManager.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
