# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-bio-sdk
pkgver=1.1.2
pkgrel=1
pkgdesc='Linxira Bio SDK - local-first bioinformatics toolkit (CLI + engine)'
arch=('x86_64')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-bio-sdk'
license=('AGPL-3.0-or-later')
depends=('gcc-libs')
makedepends=('rust' 'clang' 'mold')
options=('!strip' '!debug')  # bio-cli 构建产物无调试符号, makepkg strip 索引会报错

_commit=a25484defc3a3bf9f5572c7dfafa530c5c3fc906
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/Linxira-OS/$pkgname/tar.gz/$_commit")
sha256sums=('66631e373ce3877c022367474dde329184a9d1f8518a575d2c08a349486b7c78')

build() {
  cd "$srcdir/$pkgname-$_commit"
  export CARGO_TARGET_DIR=target
  cargo build --release --package linxira-bio-cli
}

check() {
  cd "$srcdir/$pkgname-$_commit"
  ./target/release/linxira-bio --help > /dev/null
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  install -Dm755 target/release/linxira-bio "$pkgdir/usr/bin/linxira-bio"
}
