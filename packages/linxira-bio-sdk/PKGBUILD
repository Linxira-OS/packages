# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-bio-sdk
pkgver=1.1.4
pkgrel=1
pkgdesc='Linxira Bio SDK - local-first bioinformatics toolkit (CLI + engine)'
arch=('x86_64')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-bio-sdk'
license=('AGPL-3.0-or-later')
depends=('gcc-libs')
makedepends=('rust' 'clang' 'mold')
options=('!strip' '!debug')  # bio-cli 构建产物无调试符号, makepkg strip 索引会报错

_commit=18906c828fa6cc9578a4bbdc7f080cd96be341ea
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/Linxira-OS/$pkgname/tar.gz/$_commit")
sha256sums=('2edd4937e2510ea60d06e5eefefa562a7127f64c0f4675bc58d9f4d4a10712eb')

build() {
  cd "$srcdir/$pkgname-$_commit"
  export CARGO_TARGET_DIR=target
  cargo build --release --package linxira-bio-cli
}

check() {
  cd "$srcdir/$pkgname-$_commit"
  ./target/release/linxira-bio --help > /dev/null
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  install -Dm755 target/release/linxira-bio "$pkgdir/usr/bin/linxira-bio"
  # 2026-10-24(审计 G5): AGPL 文本、第三方依赖与字体(OFL)声明必须随包分发
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  if [[ -f THIRD_PARTY.md ]]; then
    install -Dm644 THIRD_PARTY.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY.md"
  fi
  if [[ -d licenses ]]; then
    cp -a licenses "$pkgdir/usr/share/licenses/$pkgname/licenses"
  fi
}
