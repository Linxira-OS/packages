# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-chwd-detector
pkgver=1.23.0
pkgrel=1
pkgdesc='Read-only CHWD-derived hardware detector for Linxira OS'
arch=('x86_64')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-chwd-detector'
license=('GPL-3.0-only')
depends=('glibc')
makedepends=('rust' 'clang' 'pciutils' 'libusb')
checkdepends=('python')
options=('!debug')

_commit=51750c75b5ac5adb4d4db6e3ee3069c3ed6df3db
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/Linxira-OS/$pkgname/tar.gz/$_commit")
sha256sums=('e379d8a00b611c3d4b0d394320a4f581b640e1c392bff16391c26716e142010b')

build() {
  cd "$srcdir/$pkgname-$_commit"
  cargo build --release --locked
}

check() {
  cd "$srcdir/$pkgname-$_commit"
  cargo fmt --all -- --check
  cargo test --all-targets --locked
  cargo clippy --all-targets --locked -- -D warnings
  ./target/release/linxira-chwd-detector >/tmp/linxira-chwd-detector-report.json
  python -c 'import json; d=json.load(open("/tmp/linxira-chwd-detector-report.json")); assert d["schema_version"] == 1'
  ! ./target/release/linxira-chwd-detector /tmp
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  install -Dm755 target/release/linxira-chwd-detector "$pkgdir/usr/bin/linxira-chwd-detector"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 UPSTREAM.md "$pkgdir/usr/share/doc/$pkgname/UPSTREAM.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
