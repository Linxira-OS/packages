# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-catalog
pkgver=3.2.3
pkgrel=1
pkgdesc='Reviewed software catalog and schema for Linxira OS'
arch=('any')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-catalog'
license=('MIT')
checkdepends=('python' 'python-jsonschema')

_commit=d013bb87f1e479ece4274273a27c610eabefe54e
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/Linxira-OS/$pkgname/tar.gz/$_commit")
sha256sums=('7baa80ccd7dd037bfedfc5846597e6cc068d87aa47b38c1b165e448735dfd44e')

check() {
  cd "$srcdir/$pkgname-$_commit"
  python -m unittest discover -s tests -v
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  install -Dm644 catalog/catalog-v3.json \
    "$pkgdir/usr/share/linxira/catalog/catalog-v3.json"
  install -Dm644 schema/catalog-v3.schema.json \
    "$pkgdir/usr/share/linxira/catalog/catalog-v3.schema.json"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
