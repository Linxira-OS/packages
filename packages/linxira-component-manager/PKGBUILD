# Maintainer: Linxira OS <admin@linxira.org>

pkgname=linxira-component-manager
pkgver=0.1.0
pkgrel=5
pkgdesc='Nested capability bundle and component manager for Linxira OS'
arch=('any')
groups=('linxira')
url='https://github.com/Linxira-OS/linxira-component-manager'
license=('MIT')
depends=('python' 'pyside6' 'polkit' 'linxira-catalog' 'linxira-components')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('appstream' 'desktop-file-utils')

_commit=4accd7877093c94ef29b34a0a91ddb4849f262c8
source=("$pkgname-$_commit.tar.gz")
sha256sums=('8951f68214eb5d1f73c52f7485a0968bff9f61faf97e957409c5a4f3423ff22e')

build() {
  cd "$srcdir/$pkgname-$_commit"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/$pkgname-$_commit"
  LINXIRA_CATALOG_PATH=/usr/share/linxira/catalog/catalog-v3.json \
    PYTHONPATH=src QT_QPA_PLATFORM=offscreen \
    python -m unittest discover -s tests -v
  desktop-file-validate data/org.linxira.ComponentManager.desktop
  appstreamcli validate --no-net data/org.linxira.ComponentManager.metainfo.xml
}

package() {
  cd "$srcdir/$pkgname-$_commit"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 data/org.linxira.ComponentManager.desktop \
    "$pkgdir/usr/share/applications/org.linxira.ComponentManager.desktop"
  install -Dm644 data/org.linxira.ComponentManager.metainfo.xml \
    "$pkgdir/usr/share/metainfo/org.linxira.ComponentManager.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  find "$pkgdir" -type d -name __pycache__ -prune -exec rm -rf {} +
  find "$pkgdir" -type f -name '*.pyc' -delete
}
