"""刷新 monorepo 中 codeload 来源包的 sha256sums，使其与当前 GitHub 返回一致。"""
import re
import subprocess
import sys
from pathlib import Path

PKG = Path("packages")


def parse_array(text, name):
    """提取 name=(...) 数组元素列表（单引号项）。"""
    m = re.search(rf"(?ms)^{name}=\(\s*(.*?)\s*\)", text)
    if not m:
        return []
    return re.findall(r"'([^']+)'", m.group(1))


def write_array(text, name, items):
    arr = f"{name}=({items})"
    m = re.search(rf"(?ms)^{name}=\(\s*.*?\)", text)
    return text[:m.start()] + arr + text[m.end():]


results = []
for pkgbuild in sorted(PKG.glob("*/PKGBUILD")):
    text = pkgbuild.read_text(encoding="utf-8")
    sources = parse_array(text, "source")
    shas = parse_array(text, "sha256sums")
    if not sources or len(sources) != len(shas):
        continue
    commit = None
    m = re.search(r"_commit=([0-9a-f]{40})", text)
    if m:
        commit = m.group(1)
    changed = False
    for idx, src in enumerate(sources):
        if "codeload.github.com" not in src:
            continue
        # URL 形如 https://codeload.github.com/<owner>/<repo>/tar.gz/<ref>
        url = src.split("::")[-1]
        m2 = re.match(r"https://codeload\.github\.com/([^/]+)/([^/]+)/tar\.gz/([0-9a-f]{40})$", url)
        if not m2:
            continue
        owner, repo, ref = m2.groups()
        out = Path("_sha_refresh") / f"{pkgbuild.parent.name}-{ref[:10]}.tar.gz"
        out.parent.mkdir(exist_ok=True)
        r = subprocess.run(
            ["curl", "-sL", "-o", str(out), "-w", "%{http_code}", "-f",
             f"https://codeload.github.com/{owner}/{repo}/tar.gz/{ref}"],
            capture_output=True, text=True)
        if r.stdout.strip() != "200" or not out.exists() or out.stat().st_size == 0:
            results.append((pkgbuild.parent.name, "下载失败", r.stdout))
            continue
        new_sha = subprocess.run(["sha256sum", str(out)], capture_output=True, text=True
                                 ).stdout.split()[0]
        if new_sha != shas[idx]:
            shas[idx] = new_sha
            changed = True
            results.append((pkgbuild.parent.name, "已刷新", new_sha[:16]))
        else:
            results.append((pkgbuild.parent.name, "一致", shas[idx][:16]))
    if changed:
        items = " ".join(f"'{s}'" for s in shas)
        text = write_array(text, "sha256sums", items)
        pkgbuild.write_text(text, encoding="utf-8")

print(f"{'包':30s} {'结果':8s} 值")
for name, st, val in results:
    print(f"{name:30s} {st:8s} {val}")
